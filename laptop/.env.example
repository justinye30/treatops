# Copy this file to .env (same folder) and fill in after the =.
# .env is gitignored, so your keys stay on your laptop.

# Counting candy and writing roasts. Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# The plushie's voice. Get a key at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Optional: another ElevenLabs voice (its ID from their voice library)
# ELEVENLABS_VOICE_ID=

# The ESP32's IP (it prints it on boot) or treatops.local. Leave empty to test on a desk: the voice
# plays on this laptop and plushie commands are only printed.
PLUSHIE_HOST=
# The phone camera's index, from find_camera.py
CAMERA_INDEX=1
# 1 keeps each grab's before/after/hand photos in grabs/, to see what the counter was shown
SAVE_GRABS=0
# 1 if the plushie's eyes look away from the hand instead of at it (the camera faces the other way)
LOOK_FLIP=0

# The dashboard, at http://localhost:8080. 0.0.0.0 opens it to other devices on the network (it shows
# photos of trick-or-treaters: only on a network you trust).
DASHBOARD_PORT=8080
DASHBOARD_HOST=127.0.0.1
